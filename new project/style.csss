/* --- Global Resets & Variables --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg-light: #f9f6f0;       /* Warm warm/off-white background */
    --text-dark: #333333;      /* Primary dark text */
    --text-muted: #666666;     /* Secondary lighter text */
    --accent-orange: #c85a32;  /* Hero CTA button color */
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Plus Jakarta Sans', sans-serif;
}

body {
    font-family: var(--font-body);
    background-color: var(--bg-light);
    color: var(--text-dark);
    line-height: 1.6;
}

img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* --- Navigation Bar --- */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background-color: var(--bg-light);
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
}

.logo i {
    font-size: 28px;
    color: var(--text-dark);
}

.logo small {
    font-size: 10px;
    letter-spacing: 2px;
    font-family: var(--font-body);
    font-weight: 400;
    text-transform: uppercase;
}

.nav-links a {
    text-decoration: none;
    color: var(--text-dark);
    margin-left: 30px;
    font-size: 15px;
    font-weight: 500;
    transition: color 0.3s;
    position: relative;
}

.nav-links a.active::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    background-color: var(--text-dark);
    bottom: -6px;
    left: 0;
}

/* --- Hero Section --- */
.hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    background: linear-gradient(to right, #ded8cd 45%, #ece6dc 100%);
    min-height: 500px;
    align-items: center;
}

.hero-content {
    padding: 40px 10% 40px 16%;
}

.hero-content h1 {
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 20px;
}

.hero-content p {
    font-size: 16px;
    color: var(--text-muted);
    margin-bottom: 35px;
}

.btn-primary {
    display: inline-block;
    background-color: var(--accent-orange);
    color: #ffffff;
    text-decoration: none;
    padding: 14px 35px;
    border-radius: 4px;
    font-weight: 500;
    font-size: 15px;
    transition: background-color 0.3s;
}

.btn-primary:hover {
    background-color: #b04b27;
}

.hero-image {
    height: 100%;
    min-height: 450px;
}

/* --- Section Global Typography --- */
.section-title {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 400;
    text-align: center;
    color: var(--text-dark);
}

.section-subtitle {
    font-size: 14px;
    color: var(--text-muted);
    text-align: center;
    margin-top: 5px;
    margin-bottom: 40px;
}

/* --- Services Section --- */
.services-section {
    padding: 60px 8%;
    background-color: #f6f1e7;
    border-bottom: 1px solid #ebe2d3;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 40px;
}

.service-card {
    display: flex;
    align-items: center;
    gap: 20px;
    background-color: transparent;
}

.service-icon {
    font-size: 32px;
    color: #a68c6d;
    background-color: #ede5d7;
    width: 65px;
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
}

.service-info h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 4px;
}

.service-info p {
    font-size: 13px;
    color: var(--text-muted);
}

/* --- Featured Projects Section --- */
.projects-section {
    padding: 60px 8% 80px 8%;
    background-color: #f6f1e7;
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}

.project-card {
    text-align: center;
}

.project-img {
    height: 250px;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 15px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

.project-card h4 {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-dark);
}

/* --- Responsive Adjustments --- */
@media (max-width: 992px) {
    .hero {
        grid-template-columns: 1fr;
    }
    .hero-content {
        padding: 60px 8%;
    }
    .services-grid, .projects-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
    .service-card {
        justify-content: center;
        text-align: left;
    }
}
